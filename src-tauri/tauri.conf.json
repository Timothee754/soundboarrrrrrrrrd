{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundboarrrrrrrrrd",
  "mainBinaryName": "Soundboarrrrrrrrrd",
  "version": "0.1.0",
  "identifier": "com.timothee754.soundboarrrrrrrrrd",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Soundboarrrrrrrrrd",
        "create": false,
        "width": 720,
        "height": 640,
        "minWidth": 360,
        "minHeight": 400,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": { "depends": ["pulseaudio-utils"] },
      "rpm": { "depends": ["pulseaudio-utils"] }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
